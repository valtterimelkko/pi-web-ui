+/**
+ * Verify a pinned handoff offer against the file on disk.
+ *
+ * The offer pins the offered file's SHA-256 together with its byte length. A
+ * whole-file equality check alone dead-ends every handoff in a Pi Web UI host:
+ * both the idle source and the freshly opened target carry extensions that
+ * persist a registry snapshot into the session JSONL (observed 2026-09-15:
+ * `bg-shell-tasks` and `background-tasks` entries appearing at session load),
+ * so the pinned bytes can legitimately gain whole appended entries between the
+ * offer and the claim.
+ *
+ * An offer therefore matches when EITHER the file is byte-identical, OR the
+ * pinned byte prefix is still byte-identical (SHA-256 over exactly the pinned
+ * length) and the file only grew with whole appended lines. Rewrites,
+ * reordering, truncation, partial writes, and a missing pinned length all fail
+ * closed, and the caller keeps the offer for diagnosis.
+ */
+export function inspectHandoffPin(sessionFile, pinnedFingerprint, pinnedBytes) {
+	try {
+		const before = statSync(sessionFile);
+		if (before.size > MAX_SESSION_FILE_BYTES) {
+			return { ok: false, reason: `session file exceeds ${MAX_SESSION_FILE_BYTES} bytes` };
+		}
+		const buffer = readFileSync(sessionFile);
+		const after = statSync(sessionFile);
+		if (!stableStat(before, after)) return { ok: false, reason: "session file changed while checking the handoff offer" };
+		if (buffer.length === 0 || buffer[buffer.length - 1] !== 0x0a) {
+			return { ok: false, reason: "session file is not newline-terminated" };
+		}
+		const fingerprint = createHash("sha256").update(buffer).digest("hex");
+		if (fingerprint === pinnedFingerprint) {
+			return { ok: true, fingerprint, bytes: buffer.length, appendOnlyGrowth: false };
+		}
+		// An offer written before the byte length was pinned cannot prove a
+		// prefix relationship; it keeps the original strictness.
+		if (!Number.isInteger(pinnedBytes) || pinnedBytes <= 0 || buffer.length < pinnedBytes) {
+			return { ok: false, reason: "session changed after the handoff was offered" };
+		}
+		const prefixFingerprint = createHash("sha256").update(buffer.subarray(0, pinnedBytes)).digest("hex");
+		if (prefixFingerprint !== pinnedFingerprint) {
+			return { ok: false, reason: "session changed after the handoff was offered" };
+		}
+		return { ok: true, fingerprint, bytes: buffer.length, appendOnlyGrowth: buffer.length > pinnedBytes };
+	} catch (error) {
+		return { ok: false, reason: `could not verify the handoff offer: ${error instanceof Error ? error.message : String(error)}` };
+	}
+}
