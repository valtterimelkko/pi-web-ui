        "not",
        "deploy",
        "until",
        "approve",
        "ticket"
      ]
    },
    {
      "id": "t3",
      "kind": "adaptive-confirm",
      "text": "Yes, send it.",
      "requiredWords": [
        "yes",
        "send"
      ]
    }
  ],
  "permittedRouteOutcomes": [
    "relay-proposal"
  ],
  "expectedSlots": {
    "mustContain": [
      "deploy",
      "staging",
      "hot fix|hotfix"
    ],
    "mustNotContain": [],
    "responseMustContain": [],
    "responseMustNotContain": []
  },
  "requiredNegations": [
