# Pi Web UI tools root anchor (D0; rollout finding 2026-09-30).
#
# Placement's per-child groups live under this service's cgroup, not directly in
# pi-web-ui-tools.slice. systemd 255 ignores Delegate= on slice units, so every
# daemon-reload cleared the slice's cgroup.subtree_control and a live child's group
# lost its limit files. A service CAN be delegated: systemd then never touches the
# subtree below it. Proven on disposable units before rollout (reload keeps the
# controllers and a live child's memory.max; see the D0 evidence bundle addendum).
#
# - DelegateSubgroup=supervisor: this unit's own process sits in a subgroup, so the
#   server may enable +cpu +memory +pids in the anchor's subtree_control
#   (cgroup v2's no-internal-processes rule).
# - OOMPolicy=continue: REQUIRED. A per-child OOM kill counts against this unit; under
#   the default OOMPolicy=stop the anchor fails and systemd kills every placed command
#   of every child (proven on a disposable anchor).
# - ExitType=cgroup + OOMScoreAdjust=-1000 (Luna D0 live re-run finding 3, proven on
#   disposable units): if the anchor's own sleeper dies, the unit stays active while any
#   placed command remains, so the commands and their limits survive; the kernel never
#   picks the sleeper (placed commands are reset to score 0 by the wrapper, not
#   inherited from here). When the last command exits, Restart= brings the anchor back.
# - ExecStart re-enables +cpu +memory +pids in the anchor's own subtree_control, so a
#   restarted anchor (fresh cgroup) is usable at once. `$$` and `%%` are systemd
#   escapes; an unescaped `${...}` is expanded by systemd itself, to an empty string.
# - No memory limits here: pi-web-ui-tools.slice is the bound (18G max, 14G high).
# - A deliberate `systemctl stop`/`restart` still kills every placed command. Do it
#   only when no child is running, then drain-restart pi-web-ui.
#
# Install (parent's rollout): copy to /etc/systemd/system/, then
# `systemctl daemon-reload && systemctl enable --now pi-web-ui-tools-anchor.service`.
[Unit]
Description=Pi Web UI tools root anchor (D0 delegated subtree for agents' tool processes)
Before=pi-web-ui.service

[Service]
Type=exec
Slice=pi-web-ui-tools.slice
Delegate=cpu memory pids
DelegateSubgroup=supervisor
OOMPolicy=continue
OOMScoreAdjust=-1000
ExitType=cgroup
ExecStart=/bin/sh -c 'r=/sys/fs/cgroup$$(sed -n "s|^0::||;s|/supervisor$$||p" /proc/self/cgroup); [ -d "$$r" ] || exit 1; echo "+cpu +memory +pids" > "$$r/cgroup.subtree_control" || exit 1; exec sleep infinity'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
