{
  "name": "@pi-web-ui/session-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Session cards and transcript list (React), styled through tokens; source-exported for the consumer's Vite",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ChildrenStrip": "./src/ChildrenStrip.tsx",
    "./CodeBlock": "./src/CodeBlock.tsx",
    "./CollapsibleToolCard": "./src/CollapsibleToolCard.tsx",
    "./GoalPanel": "./src/GoalPanel.tsx",
    "./MessageBubble": "./src/MessageBubble.tsx",
    "./SessionView": "./src/SessionView.tsx",
    "./StreamingText": "./src/StreamingText.tsx",
    "./SubagentToolCard": "./src/SubagentToolCard.tsx",
    "./ThinkingBlock": "./src/ThinkingBlock.tsx",
    "./TodoToolCard": "./src/TodoToolCard.tsx",
    "./ToolGroupContainer": "./src/ToolGroupContainer.tsx",
    "./VirtualizedMessageList": "./src/VirtualizedMessageList.tsx",
    "./WatchStrip": "./src/WatchStrip.tsx",
    "./goalModel": "./src/goalModel.ts",
    "./piExtensionControls": "./src/piExtensionControls.ts",
    "./tokens.css": "./src/tokens.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pi-web-ui/session-core": "0.1.0"
  },
  "peerDependencies": {
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-virtuoso": "^4.18.3",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.45",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^23.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
